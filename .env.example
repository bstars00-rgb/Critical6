# Supabase — copy to .env.local and fill in (Project Settings → API)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI provider: "mock" (default) | "claude" | "openai"
VITE_AI_PROVIDER=mock
# Only needed when VITE_AI_PROVIDER != mock (proxy through an edge function in prod)
VITE_AI_API_KEY=
